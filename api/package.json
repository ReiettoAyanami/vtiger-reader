{
  "name": "vtiger-reader-api",
  "version": "0.1.0",
  "private": true,
  "license": "Unlicense",
  "description": "vtiger-reader HTTP API (Fastify + mysql2): a read-only frontend to a vtiger / OpenCRM Italia CRM",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run --config vitest.unit.config.ts && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "luxon": "3.7.2",
    "mysql2": "3.24.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
