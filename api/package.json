{
  "name": "vtiger-reader",
  "productName": "vtiger reader",
  "version": "0.1.0",
  "private": true,
  "license": "Unlicense",
  "description": "vtiger reader: a fast, read-only desktop frontend to a vtiger / OpenCRM Italia CRM (Electron, Fastify, SQLite)",
  "author": "lenzi",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "web": "npm --prefix ../web run build",
    "desktop": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "dist": "npm run web && npm run build && electron-builder --win --publish never && node scripts/check-dist.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "vitest run --config vitest.unit.config.ts && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "luxon": "3.7.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/luxon": "3.7.5",
    "@types/node": "22.20.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
